---
import type { Post } from '../lib/posts';

/**
 * Older / newer article in the same section. Two more internal links per page,
 * and an obvious next move for a reader who reached the end.
 */
interface Props {
  prev: Post | null;
  next: Post | null;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="prevnext" aria-label="More in this section">
      {next ? (
        <a class="pn" href={next.url}>
          <span class="pn-dir">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" />
            </svg>
            Newer
          </span>
          <span class="pn-title">{next.data.title}</span>
        </a>
      ) : (
        <span />
      )}

      {prev && (
        <a class="pn pn--right" href={prev.url}>
          <span class="pn-dir">
            Older
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </span>
          <span class="pn-title">{prev.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
  }

  .pn {
    display: grid;
    gap: 8px;
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 16px;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .pn:hover {
    border-color: var(--c, var(--accent));
    transform: translateY(-2px);
  }

  .pn--right {
    text-align: right;
  }

  .pn-dir {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .pn--right .pn-dir {
    justify-content: flex-end;
  }
  .pn-dir svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .pn-title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.18;
    color: var(--text);
    transition: color 0.15s var(--ease);
  }
  .pn:hover .pn-title {
    color: var(--c, var(--accent));
  }

  @media (max-width: 640px) {
    .prevnext {
      grid-template-columns: minmax(0, 1fr);
    }
    .pn--right {
      text-align: left;
    }
    .pn--right .pn-dir {
      justify-content: flex-start;
    }
  }
</style>
