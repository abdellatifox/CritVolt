---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES } from '../consts';
import { getAllPosts } from '../lib/posts';

// A 404 that offers the newest posts recovers traffic that would otherwise bounce.
const latest = (await getAllPosts()).slice(0, 4);
---

<BaseLayout title="Page not found" noindex={true}>
  <div class="wrap page">
    <p class="code">404</p>
    <h1>You died.</h1>
    <p class="lead">
      This page does not exist, or it moved. Pick up from one of these instead.
    </p>

    <nav class="jump">
      {CATEGORIES.map((c) => (
        <a class="btn btn--ghost" href={c.href} data-cat={c.id}>{c.label}</a>
      ))}
    </nav>
  </div>

  <div class="wrap">
    <div class="section-head"><h2>Latest from CritVolt</h2></div>
    <div class="grid grid--4">
      {latest.map((p) => <ArticleCard post={p} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    text-align: center;
    padding-block: 70px 40px;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 9rem);
    font-weight: 700;
    line-height: 0.85;
    color: var(--accent);
    text-shadow: 0 0 60px var(--accent-glow);
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    text-transform: uppercase;
    margin-top: 10px;
  }
  .lead {
    color: var(--text-2);
    margin-top: 12px;
  }
  .jump {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  .jump a:hover {
    border-color: var(--c);
    color: var(--c);
  }
</style>
