---
import '../styles/global.css';
import Header from '../components/Header.astro';
import AdBand from '../components/AdBand.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { SITE, GTM_ID } from '../consts';
import { CDN_BASE, CDN_IS_REMOTE } from '../lib/cdn';
import GoogleTagManager from '../components/GoogleTagManager.astro';

/**
 * Every page renders through this. It owns the <head>, which means SEO can
 * never drift between page types: one canonical strategy, one OG strategy,
 * one place to add analytics or an ad script.
 */
interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative social image. */
  image?: string;
  /** Article pages pass "article" so Open Graph is correct. */
  ogType?: 'website' | 'article';
  /** Set true on thin pages (pagination, tags) you do not want indexed. */
  noindex?: boolean;
  /** Any structured-data objects to embed. */
  jsonLd?: Record<string, unknown>[];
  /** Set false to drop the banner band (sign-up, 404). */
  ads?: boolean;
  /**
   * The LCP image, preloaded so the browser can start it while it is still
   * parsing the head. Without this the request is only discovered when the
   * parser reaches the <img>, which is what Lighthouse reports as "LCP request
   * discovery". Pass the same src/srcset/sizes the image itself uses, or the
   * browser fetches a second copy.
   */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  ads = true,
  preloadImage,
} = Astro.props;

/** Ad unit names carry the route, so reporting is readable per section. */
const adKey = (Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'home').toLowerCase();

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />

    {/*
      Images are served from R2, which is a different origin: the browser has
      to do a DNS lookup, a TCP connect and a TLS handshake before it can even
      request the LCP cover. Preconnecting overlaps all three with HTML
      parsing. Without this, moving images off-origin is a net LCP loss - the
      same request-chain problem that made the third-party font stylesheet so
      expensive. It sits above <title> so it is the first thing discovered.
    */}
    {
      CDN_IS_REMOTE && (
        <>
          <link rel="preconnect" href={new URL(CDN_BASE).origin} crossorigin />
          <link rel="dns-prefetch" href={new URL(CDN_BASE).origin} />
        </>
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <!--
      Fonts are self-hosted (scripts/fetch-fonts.mjs) and imported from the CSS
      bundle, so there is no third-party stylesheet blocking first render.
      Only the two faces used above the fold are preloaded - preloading all
      four would compete with the LCP image for bandwidth.
    -->
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }

    <link
      rel="preload"
      href="/fonts/inter-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
    {/*
      Last in <head>, not first.

      Google's docs say "as high as possible", which is about measurement
      accuracy and costs a few milliseconds of it. Placed above, the injected
      gtm.js is discovered before the LCP preload and the fonts and competes
      with them for bandwidth on exactly the requests that decide the score.
      Below them, the browser starts the cover and the fonts first and GTM
      fills the gap. The tag still fires on the same page load.
    */}
    <GoogleTagManager id={GTM_ID} placement="head" />
  </head>

  <body>
    <GoogleTagManager id={GTM_ID} placement="body" />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {ads && <AdBand id={`${adKey}-band-leaderboard`} />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
  </body>
</html>
