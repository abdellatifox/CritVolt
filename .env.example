# Free key from https://rawg.io/apikey — takes about two minutes.
# Without it the cover fetcher falls back to Steam, which only covers PC titles
# and ships smaller artwork.
RAWG_API_KEY=

# Optional: your email provider's form endpoint for the sign-up form.
# Read at build time and written into the form's action attribute, so it must
# carry the PUBLIC_ prefix. Not a secret - it is a public form endpoint.
# (Or hardcode NEWSLETTER_ACTION in src/consts.ts instead.)
PUBLIC_NEWSLETTER_ACTION=

# Free key from https://www.steamgriddb.com/profile/preferences/api
# Used by `npm run posters` to find portrait cover art. Server-side only -
# never prefixed PUBLIC_, so it is not exposed to the browser.
STEAMGRIDDB_API_KEY=

# Public base URL for image assets (R2 bucket or custom CDN domain).
# Images are authored as /img/... everywhere; src/lib/cdn.ts prepends this.
# Leave EMPTY to serve images from the deployment itself - that is a working
# fallback, not a broken state.
PUBLIC_CDN_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# PUBLIC_ because it is injected into the page and visible to everyone - it is
# a container ID, not a secret. Leave EMPTY to ship no analytics at all, which
# is what local development and preview builds should normally do.
PUBLIC_GTM_ID=
