# Free key from https://rawg.io/apikey — takes about two minutes.
# Without it the cover fetcher falls back to Steam, which only covers PC titles
# and ships smaller artwork.
RAWG_API_KEY=

# Optional: your email provider's form endpoint for the sign-up form.
# Read at build time and written into the form's action attribute, so it must
# carry the PUBLIC_ prefix. Not a secret - it is a public form endpoint.
# (Or hardcode NEWSLETTER_ACTION in src/consts.ts instead.)
PUBLIC_NEWSLETTER_ACTION=
