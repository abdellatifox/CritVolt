{
  "name": "critvolt",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/responsive-images.mjs",
    "build": "astro build",
    "postbuild": "node --env-file-if-exists=.env.production --env-file-if-exists=.env scripts/perf-check.mjs",
    "perf": "node --env-file-if-exists=.env.production --env-file-if-exists=.env scripts/perf-check.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "covers": "node scripts/fetch-covers.mjs",
    "images": "node scripts/optimize-images.mjs",
    "images:dry": "node scripts/optimize-images.mjs --dry",
    "images:responsive": "node scripts/responsive-images.mjs",
    "covers:dry": "node scripts/fetch-covers.mjs --dry",
    "posters": "node scripts/fetch-posters.mjs",
    "posters:dry": "node scripts/fetch-posters.mjs --dry",
    "posters:find": "node scripts/poster-candidates.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "drafts": "node ../content-drafts/publish.mjs",
    "drafts:dry": "node ../content-drafts/publish.mjs --dry",
    "r2:sync": "node --env-file-if-exists=.env.production --env-file-if-exists=.env scripts/r2-sync.mjs",
    "r2:verify": "node --env-file-if-exists=.env.production --env-file-if-exists=.env scripts/r2-sync.mjs --verify",
    "d1:migrate": "npx wrangler d1 execute critvolt-db --file migrations/0001_init.sql --remote -y",
    "d1:migrate:local": "npx wrangler d1 execute critvolt-db --file migrations/0001_init.sql --local -y",
    "d1:seed": "node scripts/d1-seed.mjs",
    "d1:seed:local": "node scripts/d1-seed.mjs --local",
    "d1:sql": "node scripts/d1-seed.mjs --sql",
    "deploy": "npm run r2:sync && npm run build && npm run d1:seed && npm run pages:deploy",
    "pages:deploy": "npx wrangler pages deploy dist --project-name=critvolt"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
